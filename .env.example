HTTP_ADDR=:18880

WHISPER_BACKEND=faster-whisper
WHISPER_MODEL=whisper-1
WHISPER_FASTER_URL=http://127.0.0.1:19000
WHISPER_FASTER_MODEL=turbo
WHISPER_FASTER_HOST=127.0.0.1
WHISPER_FASTER_PORT=19000
WHISPER_FASTER_DEVICE=cuda
WHISPER_FASTER_COMPUTE_TYPE=float16
WHISPER_FASTER_BATCH_SIZE=8
WHISPER_FASTER_NUM_WORKERS=2
WHISPER_FASTER_CPU_THREADS=2
WHISPER_FASTER_BEAM_SIZE=1
WHISPER_FASTER_VAD_FILTER=false

WHISPER_LOCAL_BIN=whisper
WHISPER_LOCAL_MODEL=models/ggml-base.bin
WHISPER_LOCAL_ARGS=-m "{{model}}" -f "{{input}}" -otxt -of "{{output}}" {{language_flag}}
WHISPER_LANGUAGE=auto
WHISPER_LOCAL_NO_GPU=false
WHISPER_TIMEOUT=300s


# Optional OpenAI-compatible LLM for translation / summary
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=120s



DEFAULT_CHUNK_SECONDS=8
DEFAULT_OVERLAP_MS=800

TASK_WORKERS=1
AUTO_SAVE_RESULTS=true
OUTPUT_DIR=outputs
CHECKPOINT_DIR=outputs/_checkpoints
CHUNK_SECONDS=45
CHUNK_PARALLELISM=3

BILIBILI_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/133.0.0.0 Safari/537.36
BILIBILI_TIMEOUT=2m

# NOTION_TOKEN=
# NOTION_VERSION=2022-06-28
# NOTION_PARENT_PAGE_ID=

# OBSIDIAN_VAULT_DIR=
# OBSIDIAN_SUBDIR=Whisper Imports

IMA_OPENAPI_CLIENTID=
IMA_OPENAPI_APIKEY=
# IMA_OPENAPI_FOLDER_ID 不用填
IMA_OPENAPI_FOLDER_ID=